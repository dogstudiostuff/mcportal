{
  "name": "MC Portal",
  "short_name": "MCPortal",
  "start_url": "/mcportal/",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#4CAF50",
  "file_handlers": [
    {
      "action": "/mcportal/",
      "accept": {
        "application/octet-stream": [".mcaddon", ".mcpack", ".mcworld"],
        "application/zip": [".zip"]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "/mcportal/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [".mcaddon", ".mcpack", ".mcworld", "application/octet-stream"]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "https://flaticon.com",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
